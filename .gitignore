# Secrets — never commit
.env
.env.*
*.pem
*.key
id_rsa*
credentials.json
*.pfx

# Local / user overlays (Claude Code convention)
CLAUDE.local.md
.claude/settings.local.json
.claude/.prism-state.json
.claude/scheduled_tasks.lock
.claude/references/

# Dev cruft
node_modules/
.DS_Store
Thumbs.db

# Backup directories (install-merge generates these under ~/.claude/
# but if someone runs the installer with a messed-up HOME they could
# land in the repo root)
backups/

# Generated test reports (tests/v3/run-all.sh output — one per run)
tests/v3/v3-report-*.md
tests/v3/v3-*.log
