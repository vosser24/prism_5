# Secrets — never commit
.env
.env.*
*.pem
*.key
id_rsa*
credentials.json
*.pfx

# Local / user overlays (runtime convention)
CLAUDE.local.md
.claude/settings.local.json
.claude/.prism-state.json
.claude/scheduled_tasks.lock
.claude/references/

# Dev cruft
node_modules/
.DS_Store
Thumbs.db

# Stray shell-redirect artifacts — a mis-parsed `2>` / `> 2` drops a 0-byte
# file named `1` or `2` in the repo root. Ignore them so they never get committed.
/1
/2

# Backup directories (install-merge generates these under ~/.claude/
# but if someone runs the installer with a messed-up HOME they could
# land in the repo root)
backups/

# Generated test reports (tests/v3/run-all.sh output — one per run)
tests/v3/v3-report-*.md
tests/v3/v3-*.log
