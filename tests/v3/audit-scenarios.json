{
  "schema_version": "3.6.0",
  "description": "PRISM audit scenarios catalog. Each scenario exercises one PRISM hook code path with curated input. The runner (tools/prism-audit-runner.mjs) spawns the target hook, pipes input_payload as JSON via stdin, captures exit code + stdout + stderr + timing, and compares against expected_*.",
  "scenarios": [
